# One ignore file for the whole monorepo. Prefer adding rules here over
# re-introducing per-package .gitignore files: a single list is far easier to
# audit than three that quietly disagree.

# Dependencies
node_modules/

# Environment variables — never commit these
.env
.env.local
.env.*.local

# Build output
dist/
dist-ssr/
build/
*.local

# Test + tooling output
coverage/
test-results/
playwright-report/
__screenshots__/
.eslintcache
*.tsbuildinfo

# Vite temp files
*.timestamp-*-*.mjs

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors — keep the checked-in extension recommendations in any package
**/.vscode/*
!**/.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local design-tool config (impeccable)
.impeccable/

# OS cruft
.DS_Store
.DS_Store?
._*
Thumbs.db

.pnpm-store
.env.production